# Language statistics hints for GitHub Linguist.
# Generated / vendored files are excluded so the language bar reflects what
# I actually wrote rather than lockfiles and exported ABIs.

# Lockfiles — machine-managed, not my code
**/package-lock.json      linguist-generated=true
**/yarn.lock              linguist-generated=true

# Exported contract ABI — regenerated by `hardhat compile`
frontend/src/utils/contractData.json linguist-generated=true

# Hardhat build outputs (kept gitignored anyway, but belt + braces)
artifacts/**              linguist-generated=true
cache/**                  linguist-generated=true
typechain/**              linguist-generated=true
typechain-types/**        linguist-generated=true

# Make sure Solidity shows up in the language bar
*.sol                     linguist-language=Solidity
*.sol                     linguist-detectable=true

# Treat Dockerfiles and YAML as detectable for the infra slice
Dockerfile                linguist-language=Dockerfile
*.yml                     linguist-detectable=true
