# Copy to .env and edit. Never commit .env to git.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hotel-dapp

# Must be long and random in production
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000

# Chain event listener — off by default, enable to auto-mirror on-chain
# events into MongoDB (bookings, reviews, cancellations)
ENABLE_CHAIN_LISTENER=false
CHAIN_RPC_URL=http://127.0.0.1:7545

# Email notifications — leave blank to use Ethereal's auto-generated test
# account (good enough for coursework demos; view sent mail via ethereal.email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HotelChain <no-reply@hotelchain.local>
