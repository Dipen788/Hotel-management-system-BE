{
  "name": "hotel-dapp-backend",
  "version": "1.0.0",
  "description": "Express/MongoDB backend for HotelChain DApp — stores off-chain guest details, room metadata, and user authentication",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-secret MONGOMS_VERSION=7.0.14 jest --runInBand --forceExit",
    "test:win": "set NODE_ENV=test&&set JWT_SECRET=test-secret&&set MONGOMS_VERSION=7.0.14&&jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testTimeout": 60000
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.14"
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.0",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
